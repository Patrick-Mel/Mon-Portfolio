# =============================================================================
# VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier en .env.local (local) et renseignez les mêmes clés dans
# Vercel → Project → Settings → Environment Variables (production).
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettez
# JAMAIS de secret.
# =============================================================================

# --- Site -------------------------------------------------------------------
# URL publique, sans barre finale. Sert aux URL canoniques, au sitemap, aux e-mails.
# (Peut aussi être modifiée dans /admin → Paramètres, qui prime ensuite.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Sans ces deux variables, le site public fonctionne avec le contenu d'exemple
# local et l'administration affiche un écran de configuration.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — clé service_role. Utilisée UNIQUEMENT côté serveur (formulaires publics,
# statistiques, création du compte admin). Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mails (Resend — resend.com) -------------------------------------------
# Notifications (contact, devis, commentaires), réponses depuis l'admin, newsletter.
# Sans clé, les soumissions sont enregistrées mais aucun e-mail n'est envoyé.
RESEND_API_KEY=
# Expéditeur d'un domaine vérifié dans Resend, ex. "Portfolio <contact@votre-domaine.com>"
EMAIL_FROM=
# Destinataire des notifications (défaut : e-mail public des paramètres)
OWNER_NOTIFICATION_EMAIL=

# --- Anti-spam Cloudflare Turnstile (facultatif, recommandé) -----------------
# dash.cloudflare.com → Turnstile. Sans clés : pot de miel + limitation de débit seuls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sécurité ----------------------------------------------------------------
# SECRET — sel des empreintes anonymes (IP hachées). Chaîne aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SALT=
